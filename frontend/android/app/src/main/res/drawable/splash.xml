<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the Mr. Momo logo on white, the same artwork as the app icon,
     so it always matches the icon. Replaces Capacitor's default splash PNGs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_momo_foreground"
        android:gravity="center"
        android:width="320dp"
        android:height="320dp" />
</layer-list>
