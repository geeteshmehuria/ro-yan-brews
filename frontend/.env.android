# Used by `npm run build:android` (vite --mode android): the Ro-Yan Android app
# (customers and the owner — the owner's login opens the dashboard).
# Not secret — these are public URLs, baked into the app at build time.
VITE_APP_TARGET=app
VITE_API_URL=https://royan-api.onrender.com
VITE_WS_URL=wss://royan-api.onrender.com
