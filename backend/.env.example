# Local dev works with no env vars at all (SQLite; login code is printed in the console).
# Copy to .env and edit. Production values are set in the Render dashboard instead.

# dev | production. In production the app refuses to start with a weak JWT_SECRET and
# the fixed dev login code can never be enabled.
ENV=dev
# Accept the fixed code 123456 (dev only — ignored when ENV=production).
OTP_DEV_MODE=true
# Random string, 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Leave unset locally for SQLite (./royan.db). Production: a Postgres URL.
# DATABASE_URL=postgresql://user:pass@host:5432/royan
# The owner account. Logging in with this email opens the admin dashboard.
ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=http://localhost:5173
# The placeholder menu is seeded automatically in dev, never in production (set true to force).
# SEED_MENU=false
# Optional: Google OAuth Client ID for direct Google sign-in
GOOGLE_CLIENT_ID=

# Email OTP via Gmail SMTP — REQUIRED in production for real login codes.
# SMTP_PASS must be a Google App Password (Google Account > Security >
# 2-Step Verification ON > App passwords), NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Ro-Yan Brews

# Brevo instead of Gmail (needed on Render's free tier, which blocks ports 25/465/587):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=2525
#   SMTP_USER=<Brevo SMTP login, ends with @smtp-brevo.com>
#   SMTP_PASS=<Brevo SMTP key, starts with xsmtpsib->
#   MAIL_FROM=you@gmail.com   # visible sender; must be verified in Brevo (defaults to SMTP_USER)
