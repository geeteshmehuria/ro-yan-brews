# Local dev works with no env vars at all (SQLite + dev OTP code 123456).
DATABASE_URL=postgresql://user:pass@host:5432/royan
JWT_SECRET=change-me-to-a-long-random-string
# The owner account. Logging in with this email (email + OTP, same as customers)
# opens the admin dashboard. Every other email is a normal customer.
ADMIN_EMAIL=geeteshmaihuria@gmail.com
OTP_DEV_MODE=true
ENV=production
CORS_ORIGINS=https://your-app.vercel.app

# Email OTP via Gmail SMTP — REQUIRED for real login codes.
# SMTP_PASS must be a Google App Password (Google Account > Security >
# 2-Step Verification ON > App passwords), NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourstall@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Ro-Yan Brews
